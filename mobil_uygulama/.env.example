# Mobil Uygulama — Ortam Değişkenleri Şablonu (Flutter)
# Bu dosyayı .env olarak kopyalayın:
#   cp .env.example .env
# .env dosyasını asla Git'e commit ETMEYİN (.gitignore'a eklenmiştir)
#
# Kullanım: flutter_dotenv paketi ile
#   await dotenv.load(fileName: '.env');
#   final url = dotenv.env['SUPABASE_URL']!;

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Supabase projenizin URL'si (Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonim (public) API anahtarı
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# ✅ Hafta 6 Mimarisi: GEMINI_API_KEY Flutter'a GÖMÜLMEMEKTEDİR.
# Flutter → Next.js /api/gemini/explain → Google Gemini zinciri kullanılır.
# Bu key yalnızca Next.js .env.local dosyasında bulunmalıdır.
# GEMINI_API_KEY=buraya-koymayin-next-js-tarafinda-tanimlayin

# ─── Next.js Backend URL ──────────────────────────────────────────────────────
# Chrome (Web) ve Windows Desktop testleri için:
API_BASE_URL=http://127.0.0.1:3000
# Android Emülatör için: API_BASE_URL=http://10.0.2.2:3000
# Gerçek iOS/Android cihaz için: API_BASE_URL=http://192.168.x.x:3000  (LAN IP)

# Uygulama ortamı: development | staging | production
APP_ENV=development
